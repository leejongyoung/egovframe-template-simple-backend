# docker-compose 실행 시 사용하는 환경 변수.
# 본 파일을 ".env"로 복사한 뒤 실제 값을 채워서 사용합니다.

APP_VERSION=5.0.2
MYSQL_VERSION=8.0.39

# 데이터베이스 자격증명 — 운영 환경에서는 충분히 강한 무작위 문자열로 교체
MYSQL_DATABASE=egovdb
MYSQL_USER=egov
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changemeRoot

# 보안 키 — 아래 명령을 각 키마다 별도로 실행하고 빈 값에 입력 (실제 값은 커밋 금지)
# openssl rand -base64 48
EGOV_JWT_SECRET=
EGOV_CRYPTO_KEY=

# 기본 8080은 평문 HTTP. TLS 종단 뒤에서는 true로 설정
JWT_COOKIE_SECURE=false
